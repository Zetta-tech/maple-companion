-- Reviewed setup artifact; never executed by application startup.
-- Apply only to the explicitly approved database. No users, grants, deletion or AM writes.
-- Database system EDITOR users bypass PERMISSIONS; owner checks remain in the backend.
BEGIN;
DEFINE TABLE IF NOT EXISTS maple_heads SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON maple_heads TYPE string;
DEFINE FIELD IF NOT EXISTS key ON maple_heads TYPE string;
DEFINE FIELD IF NOT EXISTS revision ON maple_heads TYPE int;
DEFINE FIELD IF NOT EXISTS receipt_json ON maple_heads TYPE string | null;
DEFINE FIELD IF NOT EXISTS epoch ON maple_heads TYPE int;
DEFINE INDEX IF NOT EXISTS owner_key ON maple_heads FIELDS owner, key UNIQUE;
DEFINE TABLE IF NOT EXISTS maple_operations SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON maple_operations TYPE string;
DEFINE FIELD IF NOT EXISTS key ON maple_operations TYPE string;
DEFINE FIELD IF NOT EXISTS base_revision ON maple_operations TYPE int;
DEFINE FIELD IF NOT EXISTS status ON maple_operations TYPE string;
DEFINE FIELD IF NOT EXISTS old_json ON maple_operations TYPE string | null;
DEFINE FIELD IF NOT EXISTS new_json ON maple_operations TYPE string | null;
DEFINE FIELD IF NOT EXISTS created_at ON maple_operations TYPE string;
DEFINE FIELD IF NOT EXISTS confirmed_at ON maple_operations TYPE string | null;
DEFINE FIELD IF NOT EXISTS previous_fact_id ON maple_operations TYPE string | null;
DEFINE FIELD IF NOT EXISTS receipt_json ON maple_operations TYPE string | null;
DEFINE INDEX IF NOT EXISTS owner_key ON maple_operations FIELDS owner, key UNIQUE;
DEFINE TABLE IF NOT EXISTS maple_notifications SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON maple_notifications TYPE string;
DEFINE FIELD IF NOT EXISTS key ON maple_notifications TYPE string;
DEFINE FIELD IF NOT EXISTS notification_id ON maple_notifications TYPE string;
DEFINE FIELD IF NOT EXISTS operation_id ON maple_notifications TYPE string;
DEFINE FIELD IF NOT EXISTS revision ON maple_notifications TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON maple_notifications TYPE string;
DEFINE INDEX IF NOT EXISTS owner_key ON maple_notifications FIELDS owner, key UNIQUE;
DEFINE TABLE IF NOT EXISTS maple_assessments SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON maple_assessments TYPE string;
DEFINE FIELD IF NOT EXISTS key ON maple_assessments TYPE string;
DEFINE FIELD IF NOT EXISTS profile_revision ON maple_assessments TYPE int;
DEFINE FIELD IF NOT EXISTS policy_digest ON maple_assessments TYPE string;
DEFINE FIELD IF NOT EXISTS assessment_date ON maple_assessments TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON maple_assessments TYPE string;
DEFINE FIELD IF NOT EXISTS result_json ON maple_assessments TYPE string;
DEFINE INDEX IF NOT EXISTS owner_key ON maple_assessments FIELDS owner, key UNIQUE;
DEFINE TABLE IF NOT EXISTS maple_assessment_notifications SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON maple_assessment_notifications TYPE string;
DEFINE FIELD IF NOT EXISTS key ON maple_assessment_notifications TYPE string;
DEFINE FIELD IF NOT EXISTS notification_id ON maple_assessment_notifications TYPE string;
DEFINE FIELD IF NOT EXISTS assessment_id ON maple_assessment_notifications TYPE string;
DEFINE FIELD IF NOT EXISTS revision ON maple_assessment_notifications TYPE int;
DEFINE FIELD IF NOT EXISTS created_at ON maple_assessment_notifications TYPE string;
DEFINE INDEX IF NOT EXISTS owner_key ON maple_assessment_notifications FIELDS owner, key UNIQUE;
DEFINE TABLE IF NOT EXISTS maple_chat_previews SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON maple_chat_previews TYPE string;
DEFINE FIELD IF NOT EXISTS key ON maple_chat_previews TYPE string;
DEFINE FIELD IF NOT EXISTS base_revision ON maple_chat_previews TYPE int;
DEFINE FIELD IF NOT EXISTS utterance ON maple_chat_previews TYPE string | null;
DEFINE FIELD IF NOT EXISTS created_at ON maple_chat_previews TYPE string;
DEFINE FIELD IF NOT EXISTS expires_at ON maple_chat_previews TYPE string;
DEFINE FIELD IF NOT EXISTS status ON maple_chat_previews TYPE string;
DEFINE FIELD IF NOT EXISTS endpoint ON maple_chat_previews TYPE string | null;
DEFINE FIELD IF NOT EXISTS context ON maple_chat_previews TYPE string | null;
DEFINE FIELD IF NOT EXISTS session_id ON maple_chat_previews TYPE string | null;
DEFINE FIELD IF NOT EXISTS proposal_id ON maple_chat_previews TYPE string | null;
DEFINE INDEX IF NOT EXISTS owner_key ON maple_chat_previews FIELDS owner, key UNIQUE;
DEFINE TABLE IF NOT EXISTS maple_chat_diagnostics SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON maple_chat_diagnostics TYPE string;
DEFINE FIELD IF NOT EXISTS key ON maple_chat_diagnostics TYPE string;
DEFINE FIELD IF NOT EXISTS reason ON maple_chat_diagnostics TYPE string;
DEFINE FIELD IF NOT EXISTS evidence_json ON maple_chat_diagnostics TYPE string | null;
DEFINE FIELD IF NOT EXISTS provider_status ON maple_chat_diagnostics TYPE int | null;
DEFINE FIELD IF NOT EXISTS updated_at ON maple_chat_diagnostics TYPE string;
DEFINE INDEX IF NOT EXISTS owner_key ON maple_chat_diagnostics FIELDS owner, key UNIQUE;
DEFINE TABLE IF NOT EXISTS maple_chat_clarifications SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS owner ON maple_chat_clarifications TYPE string;
DEFINE FIELD IF NOT EXISTS key ON maple_chat_clarifications TYPE string;
DEFINE FIELD IF NOT EXISTS hours ON maple_chat_clarifications TYPE number | null;
DEFINE FIELD IF NOT EXISTS issue ON maple_chat_clarifications TYPE string;
DEFINE FIELD IF NOT EXISTS answer ON maple_chat_clarifications TYPE string | null;
DEFINE FIELD IF NOT EXISTS answered_at ON maple_chat_clarifications TYPE string | null;
DEFINE INDEX IF NOT EXISTS owner_key ON maple_chat_clarifications FIELDS owner, key UNIQUE;
DEFINE INDEX IF NOT EXISTS operation_status ON maple_operations FIELDS owner, status;
DEFINE INDEX IF NOT EXISTS preview_status ON maple_chat_previews FIELDS owner, status;
DEFINE INDEX IF NOT EXISTS assessment_revision ON maple_assessments FIELDS owner, profile_revision, policy_digest, assessment_date UNIQUE;
DEFINE TABLE IF NOT EXISTS maple_schema SCHEMAFULL PERMISSIONS NONE;
DEFINE FIELD IF NOT EXISTS version ON maple_schema TYPE int;
CREATE maple_schema:operational_v1 CONTENT { version: 1 };
COMMIT;
