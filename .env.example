# Variable names only. Provisioning, OAuth settings and real secret configuration require approval.
APP_ORIGIN=http://localhost:3000
PORT=3000
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional public verification key for networkless session validation.
CLERK_JWT_KEY=
# Each AM Context's HTTPS endpoint belongs in its server-only binding, not a global AM_ENDPOINT.
MAPLE_AM_BINDINGS_FILE=.local/am-bindings.json
MAPLE_JOURNAL_PATH=.local/operations.sqlite
# Per-user examples; secret names must match the binding file.
AM_USER_001_READ_KEY=
AM_USER_001_WRITE_KEY=
# Optional second user only after a separate private Context is available.
AM_USER_002_READ_KEY=
AM_USER_002_WRITE_KEY=
# Prepared production mode (requires separately approved setup; do not enable locally):
# NODE_ENV=production
# MAPLE_AM_ACCESS_MODE=single-owner-production
# APP_ORIGIN=https://your-owned-domain.example
# Clerk live keys and exactly one verified owner/principal are required.
# MAPLE_AM_BINDINGS_JSON may replace MAPLE_AM_BINDINGS_FILE (not both).
# The JSON uses the same nonsecret binding schema with readKeyEnv/writeKeyEnv names.
# Distinct keys alone do NOT prove least privilege; verify actual provider grants.
# Optional isolated trial, disabled by default. One Clerk test user and one Context.
# This key has full Context access; it is not a restricted reader or writer.
# NODE_ENV=development
# MAPLE_AM_ACCESS_MODE=single-user-development
# The existing AM_USER_001_READ_KEY and AM_USER_001_WRITE_KEY may contain the
# same full-access Context key only in this explicit one-user development mode.

# General SurrealDB operational database (separate from canonical AM facts).
# Use the instance SDK endpoint, such as wss://your-instance.surreal.cloud/rpc.
# Keep real values in the original project root's ignored .env.
MAPLE_DB_ENDPOINT=
MAPLE_DB_NAMESPACE=maple
MAPLE_DB_DATABASE=development
MAPLE_DB_USERNAME=maple_dev
MAPLE_DB_PASSWORD=
# Put the separate integration credentials in the original root's ignored .env.test.
# Do not use development or production credentials for this target.
# MAPLE_TEST_DB_ENDPOINT=
# MAPLE_TEST_DB_NAMESPACE=maple
# MAPLE_TEST_DB_DATABASE=test
# MAPLE_TEST_DB_USERNAME=maple_test
# MAPLE_TEST_DB_PASSWORD=

# Optional fictional Guide, kept in a DIFFERENT AM Context from ordinary memory.
# Leave unset until its dedicated Context, key and two scopes are verified.
# Existing AM_USER_001_* keys and am-bindings.json stay unchanged.
# MAPLE_DEMO_AM_BINDINGS_FILE=.local/am-demo-bindings.json
# AM_DEMO_READ_KEY=
# AM_DEMO_WRITE_KEY=
# MAPLE_GUIDE_SOURCES_FILE=<absolute path to reviewed policy-sources/guide-2026-10-25.json>
