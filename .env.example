# Variable names only. Provisioning, OAuth settings and real secret configuration require approval.
APP_ORIGIN=http://localhost:3000
PORT=3000
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional public verification key for networkless session validation.
CLERK_JWT_KEY=
# Each AM Context's HTTPS endpoint belongs in its server-only binding, not a global AM_ENDPOINT.
MAPLE_AM_BINDINGS_FILE=.local/am-bindings.json
MAPLE_JOURNAL_PATH=.local/operations.sqlite
# Per-user examples; secret names must match the binding file.
AM_USER_001_READ_KEY=
AM_USER_001_WRITE_KEY=
# Optional second user only after a separate private Context is available.
AM_USER_002_READ_KEY=
AM_USER_002_WRITE_KEY=
