{
  "name": "maple-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:db": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run --config vitest.database.config.ts"
  },
  "dependencies": {
    "@clerk/express": "2.1.83",
    "@clerk/react": "6.18.0",
    "@surrealdb/memory": "1.0.0-alpha.11",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "surrealdb": "2.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
